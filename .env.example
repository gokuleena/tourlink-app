# --- Backend (server/index.js) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3001
# Optional: the AI model the server uses (leave out to use the default)
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional but recommended once hosted: permanent storage (free Upstash Redis).
# Leave empty on your own computer. Without it, tours are kept in a temporary file
# that a free host erases when the server restarts or goes to sleep.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Frontend ---
# Where the frontend finds the backend. Local: leave as-is.
# On Vercel set this to your Render URL, e.g. https://tourlink-backend.onrender.com
VITE_API_BASE=http://localhost:3001
